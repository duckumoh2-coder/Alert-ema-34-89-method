.github/workflows/ema-alert.yml
name: Canh bao cham EMA

on:
  schedule:
    - cron: "*/5 * * * *"   # moi 5 phut (GitHub co the tre vai phut luc cao diem)
  workflow_dispatch:         # cho phep bam chay tay de thu

permissions:
  contents: write            # de luu file state.json (tranh bao lap)

concurrency:
  group: ema-alert
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4

      - name: Chay bot
        run: python3 alert_bot.py
        env:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          SYMBOLS: ${{ vars.SYMBOLS }}
          TOL_PCT: ${{ vars.TOL_PCT }}
          REARM_PCT: ${{ vars.REARM_PCT }}

      - name: Luu trang thai
        if: always()
        run: |
          git config user.name "ema-bot"
          git config user.email "ema-bot@users.noreply.github.com"
          git add state.json || true
          git diff --cached --quiet || (git commit -m "Cap nhat trang thai canh bao" && git pull --rebase && git push)
